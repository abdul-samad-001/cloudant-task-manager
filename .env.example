# Copy this file to .env and fill in your IBM Cloudant credentials.
# Get these from your IBM Cloud dashboard -> your Cloudant resource -> Service Credentials.

CLOUDANT_URL=https://<your-instance-id>-bluemix.cloudantnosqldb.appdomain.cloud
CLOUDANT_APIKEY=<your-api-key>
CLOUDANT_AUTH_TYPE=iam

PORT=3000
